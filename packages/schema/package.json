{
  "name": "@mt/schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "seed": "node --experimental-strip-types --no-warnings src/seed.ts",
    "seed:reset": "node --experimental-strip-types --no-warnings src/seed.ts --reset",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "backup": "node --experimental-strip-types --no-warnings src/history.ts",
    "restore": "node --experimental-strip-types --no-warnings src/history.ts --restore"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
