{
  "name": "mandarin-teacher",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/start.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "seed": "npm run seed -w @mt/schema",
    "dev": "npm run api:dev",
    "api": "npm run start -w @mt/api",
    "api:dev": "npm run dev -w @mt/api",
    "build:web": "npm run build -w @mt/web",
    "study": "npm run build:web && npm run api",
    "web": "npm run dev -w @mt/web",
    "speech": ".venv\\Scripts\\python.exe pipeline/speech_server.py",
    "speech:calibrate": ".venv\\Scripts\\python.exe pipeline/speech_score.py --calibrate"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "vite": "^5.4.11"
  }
}
