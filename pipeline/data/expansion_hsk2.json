    { "hanzi": "宝宝正在睡午觉。", "pinyin": "bǎobao zhèngzài shuì wǔjiào", "gloss_en": "The baby's having a nap." },
    { "hanzi": "宝宝睡了两个小时。", "pinyin": "bǎobao shuìjiào le liǎng gè xiǎoshí", "gloss_en": "The baby slept for two hours." },
    { "hanzi": "我们每天八点洗澡。", "pinyin": "wǒmen měitiān bā diǎn xǐzǎo", "gloss_en": "We bathe at eight every day." },
    { "hanzi": "该给宝宝洗澡了。", "pinyin": "gāi gěi bǎobao xǐzǎo le", "gloss_en": "It's time to bathe the baby." },
    { "hanzi": "我在哄宝宝。", "pinyin": "wǒ zài hǒng bǎobao", "gloss_en": "I'm settling the baby." },
    { "hanzi": "你哄一下他。", "pinyin": "nǐ hǒng yíxià tā", "gloss_en": "Soothe him for a minute." },
    { "hanzi": "我喂宝宝。", "pinyin": "wǒ wèi bǎobao", "gloss_en": "I'll feed the baby." },
    { "hanzi": "你喂过他了吗？", "pinyin": "nǐ wèi le tā ma?", "gloss_en": "Have you fed him?" },
    { "hanzi": "奶粉在厨房。", "pinyin": "nǎifěn zài chúfáng", "gloss_en": "The formula's in the kitchen." },
    { "hanzi": "我们没有奶粉了。", "pinyin": "wǒmen méiyǒu nǎifěn le", "gloss_en": "We're out of formula." },
    { "hanzi": "请拿一瓶牛奶。", "pinyin": "qǐng ná yì píng niúnǎi", "gloss_en": "Grab a bottle of milk." },
    { "hanzi": "宝宝喝了一瓶奶。", "pinyin": "bǎobao hē le yì píng nǎi", "gloss_en": "The baby drank a whole bottle." },
    { "hanzi": "他的玩具在床上。", "pinyin": "tā de wánjù zài chuáng shàng", "gloss_en": "His toy's on the bed." },
    { "hanzi": "宝宝在玩玩具。", "pinyin": "bǎobao zài wán wánjù", "gloss_en": "The baby's playing with a toy." },
    { "hanzi": "别让他哭。", "pinyin": "bié ràng tā kū", "gloss_en": "Don't let him cry." },
    { "hanzi": "他为什么哭？", "pinyin": "tā wèishénme kū?", "gloss_en": "Why is he crying?" },
    { "hanzi": "因为他饿了。", "pinyin": "yīnwèi tā è le", "gloss_en": "Because he's hungry." },
    { "hanzi": "他饿了，所以哭了。", "pinyin": "tā è le, suǒyǐ kū le", "gloss_en": "He's hungry, so he cried." },
    { "hanzi": "我很累，但是很高兴。", "pinyin": "wǒ hěn lèi, dànshì hěn gāoxìng", "gloss_en": "I'm tired but happy." },
    { "hanzi": "我想睡觉，可是宝宝还没睡。", "pinyin": "wǒ xiǎng shuìjiào, kěshì bǎobao hái méi shuìjiào", "gloss_en": "I want to sleep, but the baby isn't down yet." },
    { "hanzi": "如果他哭，你就抱他。", "pinyin": "rúguǒ tā kū, nǐ jiù bào tā", "gloss_en": "If he cries, pick him up." },
    { "hanzi": "我帮你。", "pinyin": "wǒ bāng nǐ", "gloss_en": "I'll help you." },
    { "hanzi": "你可以帮我一下吗？", "pinyin": "nǐ kěyǐ bāng wǒ yíxià ma?", "gloss_en": "Can you give me a hand?" },
    { "hanzi": "等一下。", "pinyin": "děng yíxià", "gloss_en": "Hold on a second." },
    { "hanzi": "请等我。", "pinyin": "qǐng děng wǒ", "gloss_en": "Please wait for me." },
    { "hanzi": "我马上就来。", "pinyin": "wǒ jiù lái", "gloss_en": "I'll be right there." },
    { "hanzi": "我知道了。", "pinyin": "wǒ zhīdào le", "gloss_en": "Got it." },
    { "hanzi": "我不知道。", "pinyin": "wǒ bù zhīdào", "gloss_en": "I don't know." },
    { "hanzi": "你知道他在哪里吗？", "pinyin": "nǐ zhīdào tā zài nǎlǐ ma?", "gloss_en": "Do you know where he is?" },
    { "hanzi": "我觉得他饿了。", "pinyin": "wǒ juéde tā è le", "gloss_en": "I think he's hungry." },
    { "hanzi": "你觉得怎么样？", "pinyin": "nǐ juéde zěnmeyàng?", "gloss_en": "What do you think?" },
    { "hanzi": "我希望他睡得好。", "pinyin": "wǒ xīwàng tā shuìjiào hǎo", "gloss_en": "I hope he sleeps well." },
    { "hanzi": "我需要休息。", "pinyin": "wǒ xūyào xiūxi", "gloss_en": "I need a rest." },
    { "hanzi": "你应该休息一下。", "pinyin": "nǐ yīnggāi xiūxi yíxià", "gloss_en": "You should take a break." },
    { "hanzi": "我们应该走了。", "pinyin": "wǒmen yīnggāi zǒu le", "gloss_en": "We should get going." },
    { "hanzi": "我可以进来吗？", "pinyin": "wǒ kěyǐ jìnlái ma?", "gloss_en": "May I come in?" },
    { "hanzi": "请进来。", "pinyin": "qǐng jìnlái", "gloss_en": "Come in." },
    { "hanzi": "我们出去走走。", "pinyin": "wǒmen chūqù zǒu zǒu", "gloss_en": "Let's go out for a walk." },
    { "hanzi": "外面在下雨。", "pinyin": "wàimiàn zài xiàyǔ", "gloss_en": "It's raining outside." },
    { "hanzi": "今天天气很好。", "pinyin": "jīntiān tiānqì hěn hǎo", "gloss_en": "The weather's nice today." },
    { "hanzi": "今天天气怎么样？", "pinyin": "jīntiān tiānqì zěnmeyàng?", "gloss_en": "What's the weather like today?" },
